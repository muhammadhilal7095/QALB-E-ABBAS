# ---------------------------------------------------------------------------
# Qalb-E-Abbas payments — environment variables. Copy to .env and fill in.
# NEVER commit real secrets. Keep this file free of real values.
# ---------------------------------------------------------------------------

# Public URL of this payment app (used for Stripe return links).
APP_URL="http://localhost:3000"
# The main website. Booking form, cart and assessment post to this app from here.
MAIN_SITE_URL="http://localhost:8080"
# Optional: extra comma-separated website origins allowed to submit (e.g. "https://www.qalbeabbas.com").
ALLOWED_ORIGINS=""

# Where booking, order and assessment emails are sent.
ADMIN_EMAIL="contact@qalbeabbas.com"

# ---- Stripe (REQUIRED for real payments) — Dashboard → Developers → API keys / Webhooks.
# Webhook endpoint: {APP_URL}/api/webhooks/stripe  (events: checkout.session.completed,
# checkout.session.async_payment_succeeded). Use sk_test_… / whsec_… while testing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Email (REQUIRED to receive emails) — resend.com → API Keys.
# EMAIL_FROM must be an address on a domain you've verified in Resend.
# Without RESEND_API_KEY, emails are saved to booking/.emails/ for local testing.
RESEND_API_KEY=""
EMAIL_FROM="bookings@qalbeabbas.com"

# Development-only test checkout (Pay / Cancel buttons, no real money) when no Stripe key is set.
# Automatically disabled when NODE_ENV=production.
PAYMENT_MOCK_ENABLED="true"
