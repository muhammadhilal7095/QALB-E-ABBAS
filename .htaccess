# ==========================================================================
# Qalb-E-Abbas — Hostinger (LiteSpeed / Apache) hosting
# ==========================================================================
Options -MultiViews
DirectoryIndex index.html index.php
RewriteEngine On

# 1. Always use HTTPS and the www domain (one canonical version of every URL)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L,NE]

# 2. Clean URLs: /services serves services.html, old /services.html links 301 to /services
RewriteCond %{THE_REQUEST} \s/+([^.?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+index[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# 3. Never serve source/tooling folders or hidden files (the website itself is only the
#    HTML pages and /assets). The GitHub deploy doesn't upload these, but this keeps them
#    private if they are ever copied to the server.
RewriteRule ^(booking|\.git|\.github|\.work|docs)(/|$) - [R=404,L]
RewriteRule (^|/)\.(?!well-known) - [R=404,L]
RewriteRule ^(serve\.py|.*\.md)$ - [R=404,L]
# PHP API: shared code and the price copy (api/_lib.php, api/_catalog.json) are never served.
RewriteRule ^api/_ - [R=404,L]

# 4. Custom "page not found" page
ErrorDocument 404 /404.html

# 5. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# 6. Browser caching (assets are versioned with ?v=…, so they can be cached for a long time)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# 7. Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
