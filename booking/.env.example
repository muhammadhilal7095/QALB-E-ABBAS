# ---------------------------------------------------------------------------
# Qalb-E-Abbas Booking — environment variables. Copy to .env and fill in.
# NEVER commit real secrets. Keep this file free of real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection. Local dev: run `npm run db:local` (embedded PostgreSQL on port 5433).
DATABASE_URL="postgresql://qalb:qalb_dev_password@localhost:5433/qalb_booking"
# Separate database used by automated tests (created by db:local).
TEST_DATABASE_URL="postgresql://qalb:qalb_dev_password@localhost:5433/qalb_booking_test"

# Public URL of this booking app (used in emails and payment redirects).
APP_URL="http://localhost:3000"
# Main website URL (header links back to it). The website cart may create orders from this origin.
MAIN_SITE_URL="http://127.0.0.1:8080"
# Optional: extra comma-separated website origins allowed to create orders (e.g. "https://www.qalbeabbas.com").
ALLOWED_ORIGINS=""

# ---- Stripe (REQUIRES YOUR ACCOUNT) — use TEST keys (sk_test_…, whsec_…) in development.
# Dashboard → Developers → API keys / Webhooks. Webhook endpoint: {APP_URL}/api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Development-only simulated payment gateway (pay / fail / cancel buttons).
# Automatically disabled when NODE_ENV=production.
PAYMENT_MOCK_ENABLED="true"

# ---- Email (REQUIRES YOUR ACCOUNT) — Resend (resend.com). Leave empty to log emails instead of sending.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, e.g. bookings@qalbeabbas.com
EMAIL_FROM="bookings@qalbeabbas.com"

# Protects the scheduled-jobs endpoint (/api/cron) — long random string.
CRON_SECRET="change-me-to-a-long-random-string"

# ---- Optional: WhatsApp Business API provider (not yet connected — see docs/DEPLOYMENT.md)
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""
